# 复制成 .env 后填写（.env 不进仓库）
DATABASE_URL=postgres://yuanhui:<口令>@localhost:5432/yuanhui
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
MIN_BUILD=0
DEMO_LOGIN_ENABLED=0
PRIVACY_URL=https://yuanhuishop.cn/privacy
SUPPORT_URL=https://yuanhuishop.cn/support
RECOVERY_MODE=0
# 前面有 Caddy 反代时设 1，同时 TRUSTED_PROXY 填 Caddy 的地址（IP 或 CIDR，逗号分隔）。
# 只信一跳：只有 TCP 对端是 Caddy 时才看 X-Forwarded-For，而且只取最右一项（§14 S03-6）
TRUST_PROXY=0
TRUSTED_PROXY=
# 每家店在途的同步写入上限，超过返回 503 unavailable（§14 S04-8）
STORE_QUEUE_LIMIT=32
# ── S08 条码查询与商品图 ──
# 商品图总开关，默认关（条款核对前保持关闭，§12 Q2）
PRODUCT_IMAGES_ENABLED=0
# 快鸟 AppCode（阿里云云市场 cmapi00067757），只放服务器 .env；留空 = 不调外部
KUAINIAO_APPCODE=
KUAINIAO_ENDPOINT=https://icode.market.alicloudapi.com/getBarcode
BARCODE_LOOKUP_TIMEOUT_MS=2000
BARCODE_DAILY_LIMIT=300
# none / local / aliyun
OBJECT_STORE=none
OBJECT_STORE_DIR=
OSS_REGION=
OSS_BUCKET=
# 存档桶（exports/、deletions/），OBJECT_STORE=aliyun 时必填且不能和 OSS_BUCKET 相同（§14 S09-11、T13）
OSS_ARCHIVE_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
IMAGE_CACHE_DIR=/var/cache/yuanhui/images
