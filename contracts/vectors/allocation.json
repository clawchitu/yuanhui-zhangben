   "title": "必过向量（设计稿 08）：25.00/24.00/4.50 合计 53.50，实收 53.00",
   "lines": [
    {
     "unit_price_fen": 2500,
     "pack_count": 1
    },
    {
     "unit_price_fen": 2400,
     "pack_count": 1
    },
    {
     "unit_price_fen": 450,
     "pack_count": 1
    }
   ],
   "paid_total_fen": 5300,
   "expect": {
    "list_fen": [
     2500,
     2400,
     450
    ],
    "list_total_fen": 5350,
    "amount_fen": [
     2476,
     2378,
     446
    ]
   },
   "calc": "a=roundDiv(2500×5300,5350)=roundDiv(13250000,5350)=2477（2476.64）；roundDiv(12720000,5350)=2378（2377.57）；roundDiv(2385000,5350)=446（445.79）；Σ=5301，d=−1 加到最大行 2500 → 2476"
  },
