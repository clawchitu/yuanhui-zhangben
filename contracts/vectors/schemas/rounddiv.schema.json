{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rounddiv.schema.json",
  "title": "roundDiv 向量（§5.0）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "numerator_factors",
          "b",
          "expected",
          "rules",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^rd-[0-9]{2}$"
          },
          "numerator_factors": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 1
          },
          "b": {
            "type": "integer",
            "minimum": 1
          },
          "expected": {
            "type": "integer"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^5\\.[0-6]-"
            },
            "minItems": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
