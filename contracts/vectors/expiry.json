 "deduct": [
  {
   "id": "ded-01",
   "lots": [
    {
     "lot_id": "A",
     "expiry_date": "2026-12-01",
     "qty_left": 3,
     "closed": false,
     "snoozed_until": null
    },
    {
     "lot_id": "B",
     "expiry_date": null,
     "qty_left": 5,
     "closed": false,
     "snoozed_until": null
    },
    {
     "lot_id": "C",
     "expiry_date": "2026-11-25",
     "qty_left": 2,
     "closed": false,
     "snoozed_until": null
    }
   ],
   "qty": 4,
   "expected": {
    "moves": [
     {
      "lot_id": "C",
      "qty": 2
     },
     {
      "lot_id": "A",
      "qty": 2
     }
    ],
    "unassigned": 0
   },
   "note": "按到期日从早到晚：C 扣完再扣 A"
  },
  {
   "id": "ded-02",
   "lots": [
    {
     "lot_id": "A",
     "expiry_date": "2026-12-01",
     "qty_left": 3,
     "closed": false,
     "snoozed_until": null
    },
    {
     "lot_id": "B",
     "expiry_date": null,
     "qty_left": 5,
     "closed": false,
     "snoozed_until": null
    },
    {
     "lot_id": "C",
     "expiry_date": "2026-11-25",
     "qty_left": 2,
     "closed": false,
     "snoozed_until": null
    }
   ],
   "qty": 12,
   "expected": {
    "moves": [
     {
      "lot_id": "C",
      "qty": 2
     },
     {
      "lot_id": "A",
      "qty": 3
     },
     {
      "lot_id": "B",
      "qty": 5
     }
    ],
    "unassigned": 2
   },
   "note": "空日期排最后；批次不够扣的 2 个不归任何批次（不强求批次之和等于库存）"
  },
  {
   "id": "ded-03",
   "lots": [
    {
     "lot_id": "D",
     "expiry_date": "2026-11-20",
     "qty_left": 4,
     "closed": true,
     "snoozed_until": null
    },
    {
     "lot_id": "E",
     "expiry_date": "2026-11-28",
     "qty_left": 0,
     "closed": false,
     "snoozed_until": null
    },
    {
     "lot_id": "F",
     "expiry_date": "2026-11-29",
     "qty_left": 6,
     "closed": false,
     "snoozed_until": "2026-12-05"
    }
   ],
   "qty": 3,
   "expected": {
    "moves": [
     {
      "lot_id": "F",
      "qty": 3
     }
    ],
    "unassigned": 0
   },
   "note": "已关闭的不扣，qty_left=0 的跳过，「过几天再提醒」中的照常扣"
  }
 ],
 "handle_ver": [
  {
   "id": "hv-01",
   "lot": {
    "handle_ver": 2,
    "closed": false
   },
   "op_handle_ver": 2,
   "expected": {
    "result": "ok",
    "new_handle_ver": 3
   },
   "note": "版本一致：接受，handle_ver +1"
  },
  {
   "id": "hv-02",
   "lot": {
    "handle_ver": 3,
    "closed": false
   },
   "op_handle_ver": 2,
   "expected": {
    "result": "stale"
   },
   "note": "别的手机已经处理过一次（版本变了）"
  },
  {
   "id": "hv-03",
   "lot": {
    "handle_ver": 2,
    "closed": true
   },
   "op_handle_ver": 2,
   "expected": {
    "result": "stale"
   },
   "note": "批次已关闭"
  }
 ],
 "dispose": [
  {
   "id": "dis-01",
   "today": "2026-11-19",
   "lot": {
    "qty_left": 5,
    "handle_ver": 1
   },
   "op": {
    "action": "sold_out",
    "actual_qty": 0,
    "handle_ver": 1
   },
   "expected": {
    "lot": {
     "closed": true,
     "closed_reason": "disposed",
     "handle_ver": 2
    },
    "entry": null,
    "flags_qty_left_before": 5
   },
   "note": "卖完了：关批次，不动库存"
  },
  {
   "id": "dis-02",
   "today": "2026-11-19",
   "lot": {
    "qty_left": 5,
    "handle_ver": 1
   },
   "op": {
    "action": "discard",
    "actual_qty": 3,
    "handle_ver": 1
   },
   "expected": {
    "lot": {
     "closed": true,
     "closed_reason": "disposed",
     "handle_ver": 2
    },
    "entry": {
     "type": "expire_loss",
     "qty_delta": -3
    },
    "flags_qty_left_before": 5
   },
   "note": "扔掉：数量以人数的 3 为准，不是批次上的 5；金额按 cost.json 的卖出取法"
  },
  {
   "id": "dis-03",
   "today": "2026-11-19",
   "lot": {
    "qty_left": 5,
    "handle_ver": 1
   },
   "op": {
    "action": "return",
    "actual_qty": 4,
    "handle_ver": 1
   },
   "expected": {
    "lot": {
     "closed": true,
     "closed_reason": "disposed",
     "handle_ver": 2
    },
    "entry": {
     "type": "supplier_return",
     "qty_delta": -4
    },
    "flags_qty_left_before": 5
   },
   "note": "退给供货商"
  },
  {
   "id": "dis-04",
   "today": "2026-11-19",
   "lot": {
    "qty_left": 5,
    "handle_ver": 1
   },
   "op": {
    "action": "snooze",
    "actual_qty": 4,
    "handle_ver": 1,
    "days": 3
   },
   "expected": {
    "lot": {
     "closed": false,
     "qty_left": 4,
     "snoozed_until": "2026-11-22",
     "handle_ver": 2
    },
    "entry": null
   },
   "note": "还在卖、过 3 天再提醒：批次数量改成实际数（lot_snooze）"
  },
  {
   "id": "dis-05",
   "today": "2026-11-30",
   "lot": {
    "qty_left": 2,
    "handle_ver": 0
   },
   "op": {
    "action": "snooze",
    "actual_qty": 2,
    "handle_ver": 0,
    "days": 5
   },
   "expected": {
    "lot": {
     "closed": false,
     "qty_left": 2,
     "snoozed_until": "2026-12-05",
     "handle_ver": 1
    },
    "entry": null
   },
   "note": "跨月"
  }
 ],
 "undo": [
  {
   "id": "undo-01",
   "event": "void_discard",
   "lot_before": {
    "closed": true,
    "closed_reason": "disposed",
    "qty_left_before_dispose": 5
   },
   "expected": {
    "closed": false,
    "qty_left": 5
   },
   "note": "撤销「扔掉」：重新打开，qty_left 恢复为处理前的值"
  },
  {
   "id": "undo-02",
   "event": "void_return",
   "lot_before": {
    "closed": true,
    "closed_reason": "disposed",
    "qty_left_before_dispose": 5
   },
   "expected": {
    "closed": false,
    "qty_left": 5
   },
   "note": "撤销「退货」同上"
  },
  {
   "id": "undo-03",
   "event": "void_sale",
   "lot_before": {
    "closed": false,
    "qty_left": 1
   },
   "lot_move_qty": 2,
   "expected": {
    "closed": false,
    "qty_left": 3
   },
   "note": "撤销卖出：按 lot_moves 加回"
  },
  {
   "id": "undo-04",
   "event": "void_sale",
   "lot_before": {
    "closed": true,
    "closed_reason": "disposed",
    "qty_left": 1
   },
   "lot_move_qty": 2,
   "expected": {
    "closed": true,
    "qty_left": 1
   },
   "note": "撤销卖出时批次已关闭：不加回、不重开"
  },
  {
   "id": "undo-05",
   "event": "void_source_stock_in",
   "lot_before": {
    "closed": false,
    "qty_left": 7
   },
   "expected": {
    "closed": true,
    "closed_reason": "voided",
    "qty_left": 7
   },
   "note": "撤销来源进货：关闭，closed_reason=voided；已扣过的 lot_moves 不动（qty_left 不要求变）"
  }
 ]
}