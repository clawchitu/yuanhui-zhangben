{
  "$schema": "./permissions.schema.json",
  "version": 1,
  "roles": {
    "family": "家用：家用号登录或扫家人码的设备",
    "cashier": "收银员：扫收银员码的设备",
    "review": "审核：审核号登录的设备，权限同家用，但只在演示小店内",
    "revoked": "被踢设备：令牌已撤销（devices.revoked_at 非空）"
  },
  "decisions": {
    "public": "不需登录",
    "allow": "能（有 conditions 时全部满足才能，否则拒：HTTP 403 / op rejected: forbidden）",
    "deny": "拒（HTTP 403 / op rejected: forbidden）",
    "held": "不直接入账，记为 held 等家用确认（有 conditions 时不满足就拒）",
    "not_applicable": "这个身份不会调用（计划写「—」）"
  },
  "conditions": {
    "own_device_sale": "被撤销的卖出是本设备记的",
    "sale_day_eq_server_receive_day": "被撤销的卖出的 occurred_at（上海时区）日期 = 服务器收到这次撤销的日期",
    "quick_only": "product_upsert 必须 quick=true，只带名称和卖价，带了别的字段就拒",
    "occurred_at_lte_revoked_at": "op.occurred_at <= devices.revoked_at",
    "within_revoke_window": "服务器收到时距 revoked_at 不超过 30 天（§4.5 补传窗口）",
    "not_self": "目标设备不是调用者自己",
    "demo_login_enabled": "GET /v1/config 的 demo_login_enabled 为真（默认关）",
    "recovery_mode_on": "运维打开了恢复模式（§4.6）"
  },
  "global": [
    "跨店隔离：任何接口只能碰令牌所属的店；别的店的 id 一律 404（§6.1）",
    "review 身份只存在于演示店；演示店里也能开通演示用的收银员设备，那些设备按 cashier 列（§6）",
    "账号注销期间（accounts.delete_requested_at 非空）禁止写账和开通设备（§7）",
    "所有身份的 op 还要过 §5.0 的上限校验，超出 rejected: invalid（§4.4）",
    "op 行带 match 时按 payload 字段选行（product_upsert 按 quick 分两行）；每种 op 的行必须覆盖它的全部取值",
    "权限表不允许留待定的格子（§6.1）；contracts:check 遇到待定会失败"
  ],
  "rules": [
