      "id": "sync:pull",
      "kind": "sync_pull",
      "family": {
        "decision": "allow",
        "scope": "full_store"
      },
      "cashier": {
        "decision": "allow",
        "scope": "cashier_projection",
        "note": "§4.2 按角色裁剪，被裁的键不出现"
      },
      "review": {
        "decision": "allow",
        "scope": "full_store",
        "note": "只在演示店"
      },
      "revoked": {
        "decision": "deny",
        "note": "不是 401：sync 照常响应，但 changes 为空，device.revoked=true"
      },
      "source": "§6.1、§4.2"
    },
