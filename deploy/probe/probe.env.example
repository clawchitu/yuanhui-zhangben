# 本机探测的配置（S10c）。复制到 ~/.config/yuanhui-probe/env，chmod 600。真实值不进仓库。
# 一行一个 KEY=值，不加引号、不当 shell 脚本执行；只认下面这几个键。
# 探测地址：方案 A 的 IP 站点，必须 https
PROBE_URL=
# ssh 到 ECS 读 /data/monitor/outbox.jsonl（部署用的同一把密钥，例：huang-shop）。留空 = 不转发服务器告警
PROBE_SSH_TARGET=
PROBE_REMOTE_OUTBOX=/data/monitor/outbox.jsonl
# 状态目录（游标、去重状态、cert-renewals.jsonl）。留空 = ~/Library/Application Support/yuanhui-probe
PROBE_STATE_DIR=
# 发给 Chitu 的通道，至少配一个：
#   PROBE_NOTIFY_CMD：一条命令，告警正文从 stdin 喂给它，退出码 0 算发出
#   PROBE_WEBHOOK_URL / PROBE_WEBHOOK_TOKEN：POST JSON，令牌走 Authorization: Bearer
PROBE_NOTIFY_CMD=
PROBE_WEBHOOK_URL=
PROBE_WEBHOOK_TOKEN=
