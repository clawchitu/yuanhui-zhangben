# 备案通过前的 IP 站点（§9.2 方案 A）。Caddy 版本锁定 2.10.2（ACR 上的镜像，见 .env.example）。
# IP 站点 Caddy 默认用本地 CA，这里显式配置 Let's Encrypt 公网签发方和 shortlived 短期证书 profile；
# 证书状态在 /data（宿主 /data/caddy/data）持久化。
# 备案 11/26 通过（苏ICP备2026094233号）后加了 api.yuanhuishop.cn 站点和 yuanhuishop.cn 静态首页（§9.3）。
# 部署到 ECS 上是 /opt/yuanhui/caddy/Caddyfile，deploy.sh 校验后 caddy reload。
{
	email {$ACME_EMAIL}
	# 连 IP 的客户端不发 SNI；容器里 Caddy 的本地地址是 172.30.0.2 不是公网 IP，没有 SNI 时用这张证书（Fable 建议）
	default_sni {$PUBLIC_IP}
	# 不开 HTTP/3（§14 S10a-5）
	servers {
		protocols h1 h2
	}
	# 不配 trusted_proxies：Caddy 不信任何上游，客户端自带的 X-Forwarded-For 不往下传，只写它看到的对端地址
}

# 片段必须定义在引用它的站点之前
(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		-Server
	}
	# 同步 payload 上限在 api 里（1 MiB），这里给一个稍宽的硬上限挡掉超大请求
	request_body {
		max_size 2MB
	}
	# 只放行 /v1/* 和 /healthz，其余一律 404：以后 api 里加的内部路由不会直接暴露（Codex 6）
	@api path /v1/* /healthz
	handle @api {
		reverse_proxy 172.30.0.3:3000 {
			# 覆盖成 Caddy 看到的对端地址；api 只信 172.30.0.2 给的最右一项（S03-6）
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		respond 404
	}
	log {
		output stdout
		format json
	}
}

https://{$PUBLIC_IP} {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
	}
	import common
}

# 备案通过后（§9.3 第 2 步）：API 域名站点，Let's Encrypt 正常证书（HTTP-01，Caddy 自动续期）。
# 不加 shortlived profile（那是 IP 证书才要的）。http://api.yuanhuishop.cn 由 Caddy 自动 308 到 https。
api.yuanhuishop.cn {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
		}
	}
	import common
}

# tools.yuanhuishop.cn（黄总的发票工具）不在本计划范围（§9.3 第 8 步），这里只预留位置：没有解析、没有站点。

# 根域名：只有一张静态首页（deploy/site，发布时装到宿主 /opt/yuanhui/caddy/site，容器里 /etc/caddy/site）。
# 公安联网备案要求网站能打开；非交互，不反代 api，/v1 在这里是 404。www 301 到根域名。
(site_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		-Server
	}
}

yuanhuishop.cn {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
		}
	}
	import site_headers
	encode zstd gzip
	@page path / /index.html /favicon.svg
	handle @page {
		root * /etc/caddy/site
		file_server
	}
	handle {
		respond 404
	}
	log {
		output stdout
		format json
	}
}

www.yuanhuishop.cn {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
		}
	}
	import site_headers
	redir https://yuanhuishop.cn{uri} 301
}
