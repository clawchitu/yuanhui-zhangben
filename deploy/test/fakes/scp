#!/usr/bin/env bash
# 模拟 scp：最后一个参数是 主机:目标，前面是本地文件；目标里的 /opt/yuanhui 换成沙盒目录
set -eu
printf 'scp %s\n' "$*" >> "$FAKE_LOG"
args=(); for a in "$@"; do case "$a" in -*) ;; *) args+=("$a") ;; esac; done
n=${#args[@]}; dest=${args[$((n-1))]#*:}; dest=${dest//\/opt\/yuanhui/$FAKE_REMOTE}
for ((i=0; i<n-1; i++)); do cp "${args[$i]}" "$dest"; done
