# ECS 上复制成 /opt/yuanhui/.env（chmod 600，属主 root）。值一律留空，真实值不进仓库、不进 CI 日志（§9.1）。
# ── 镜像：一律从 ACR 拉（ECS 拉不动 Docker Hub）。ECS 上填 ACR 的 VPC 地址（主机名带 -vpc），
#    和 GitHub Actions 推送用的公网地址不是同一个主机名（见 docs/cloud-manual-steps.md 第 4 步）──
# API_IMAGE 由 deploy.sh 写入当前标签，不用手填
API_IMAGE=
# 例：<实例>-vpc.cn-shanghai.personal.cr.aliyuncs.com/yuanhui/caddy:2.10.2（mirror-base-images.sh 推上去的那份）
CADDY_IMAGE=
# 例：<实例>-vpc.cn-shanghai.personal.cr.aliyuncs.com/yuanhui/postgres:16
POSTGRES_IMAGE=
# ── 数据库（scram-sha-256 口令认证，§14 T2-3）──
# 只许字母数字（原样拼进连接串）：openssl rand -hex 24
POSTGRES_PASSWORD=
# ── Caddy ──
ACME_EMAIL=
PUBLIC_IP=47.117.184.253
# ── api（其余见 server/.env.example；DATABASE_URL、TRUST_PROXY、TRUSTED_PROXY 由 compose.yml 拼好，不在这里写）──
LOG_LEVEL=info
MIN_BUILD=0
DEMO_LOGIN_ENABLED=0
# 恢复模式（§4.6）：平时保持 0；只在整机恢复后按 runbook「恢复模式」临时改 1，补交完改回 0
RECOVERY_MODE=0
# T9 做完之前保持关闭、AppCode 留空（S10a）
PRODUCT_IMAGES_ENABLED=0
KUAINIAO_APPCODE=
# none / aliyun。aliyun 时两个桶都必填且不同（S09-11、T13）；RAM 子账号最小权限见 docs/cloud-manual-steps.md
OBJECT_STORE=none
OSS_REGION=oss-cn-shanghai
# 必须带 https://（loadConfig 拒绝裸域名）：https://oss-cn-shanghai-internal.aliyuncs.com
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ARCHIVE_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# ── 备份（S10b，§9.4）：备份专用的 RAM 账号（§14 T21：backups/ 只写不删、可列举和读；heartbeat/backup.json 读写；
#    deletions/ 只读和列举），写进 OSS_ARCHIVE_BUCKET（yuanhui-backup）。和上面 api 的 OSS 账号不是同一个 ──
BACKUP_OSS_ACCESS_KEY_ID=
BACKUP_OSS_ACCESS_KEY_SECRET=
# 至少 20 位：openssl rand -base64 32。存在部署机钥匙串、Haoqiang 的 iPhone「密码」App、纸质一份（§14 S10b-10，runbook「口令保管」）
BACKUP_PASSPHRASE=
# ── 监控与告警（S10c，§9.5）：告警默认只写 /data/monitor/outbox.jsonl，由本机探测拉回去发给 Chitu。
#    想让服务器另外直接推一份，填一个 https 的 webhook；令牌只放这里，不进日志、不进告警正文 ──
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
